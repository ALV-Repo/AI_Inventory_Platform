# Copy to .env and fill in. Never commit the real .env (SRS 9 - secrets management).
DATABASE_URL=postgresql+psycopg2://stockflow:stockflow@localhost:5432/stockflow
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=generate-with-openssl-rand-hex-32
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=14
CORS_ORIGINS=http://localhost:3000
SEED_DEMO_DATA=false
# Dev only - production schema is owned by Alembic migrations
AUTO_CREATE_SCHEMA=true

# AI gateway: stub | anthropic | selfhosted
AI_PROVIDER=stub
AI_API_KEY=

NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
